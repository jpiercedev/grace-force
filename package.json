{
  "name": "grace-lead-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Relationship and lead management for the ministry",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --project db",
    "test:unit": "vitest run --project unit",
    "test:ui": "vitest run --project ui",
    "e2e": "playwright test",
    "e2e:public": "playwright test --grep @public",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "db:reset": "tsx scripts/db-apply.ts --print",
    "db:types": "supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" --schema public > src/types/database.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.1",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "lucide-react": "0.545.0",
    "next": "15.5.22",
    "papaparse": "5.5.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "6.1.2",
    "server-only": "^0.0.1",
    "tailwind-merge": "2.6.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.18.1",
    "@types/papaparse": "5.3.16",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.0.4",
    "autoprefixer": "10.4.21",
    "eslint": "9.37.0",
    "eslint-config-next": "15.5.22",
    "jsdom": "27.0.0",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.18",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
