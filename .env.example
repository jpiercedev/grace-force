# ---------------------------------------------------------------------------
# Bridge CRM — environment configuration
#
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.
# Every value below is a placeholder; none of them are live credentials.
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
# Public origin of the deployed app. Used for auth redirect callbacks and for
# absolute links inside internal notification emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000


# --- Supabase (required) ----------------------------------------------------
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Service-role key. Server-only: bypasses Row Level Security.
# Used exclusively by lead intake, integration sync jobs and admin tooling.
# Must never be exposed to the browser or prefixed with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional — only needed for `npm run db:types`.
SUPABASE_PROJECT_ID=your-project-ref


# --- Mailchimp (optional) ---------------------------------------------------
# Marketing API key from Account → Extras → API keys.
# The datacenter suffix of the key (e.g. `us21`) must match MAILCHIMP_SERVER_PREFIX.
# When unset, the Mailchimp area of the app renders an "unconfigured" state and
# sync endpoints return 503 instead of failing.
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=

# Restrict sync to a single audience. Leave blank to sync every audience the
# API key can see.
MAILCHIMP_AUDIENCE_ID=

# When true, Mailchimp members with no CRM match create a new contact.
# When false, unmatched members are stored but left unlinked for manual review.
MAILCHIMP_AUTO_CREATE_CONTACTS=true


# --- Resend (optional) ------------------------------------------------------
# API key from https://resend.com/api-keys.
# When unset, notifications are recorded in the database with status `skipped`
# and nothing is sent.
RESEND_API_KEY=

# Verified sending identity, e.g. "Bridge CRM <crm@yourdomain.org>".
RESEND_FROM_EMAIL=

# Comma-separated internal recipients for lead + follow-up notifications.
NOTIFY_INTERNAL_EMAILS=


# --- Lead intake security (optional but recommended) ------------------------
# Shared secret required in the `x-bridge-intake-key` header on POST /api/leads.
# Leave blank to accept unauthenticated submissions from allowed origins only.
LEAD_INTAKE_SECRET=

# Comma-separated origins allowed to POST to the public lead intake endpoint.
# Leave blank to allow same-origin submissions only.
LEAD_INTAKE_ALLOWED_ORIGINS=

# Max submissions accepted from a single client per hour.
LEAD_INTAKE_RATE_LIMIT=10


# --- Scheduled job protection (optional) ------------------------------------
# Shared secret required by /api/cron/* endpoints (Mailchimp sync, follow-up
# reminders). Send as `Authorization: Bearer <value>`.
CRON_SECRET=


# --- End-to-end tests (optional) --------------------------------------------
# Credentials for an existing CRM user; enables the @authed Playwright suite.
E2E_EMAIL=
E2E_PASSWORD=
